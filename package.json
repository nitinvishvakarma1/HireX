{
  "name": "hirex",
  "version": "0.1.0",
  "private": true,
  "description": "HireX — AI job-application copilot (monorepo).",
  "license": "MIT",
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run start:dev -w apps/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "3.3.3",
    "turbo": "2.3.3",
    "typescript": "5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
