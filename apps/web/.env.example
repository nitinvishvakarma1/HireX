# @hirex/web — environment template. Copy to .env.local and fill in real values.
# Committed to git. NEVER put real secrets here — placeholders only.
#
# Only NEXT_PUBLIC_* vars are exposed to the browser. This app currently serves
# mock data, but the data layer is already wired to read this base URL, so it is
# validated at startup (src/lib/config.ts) — the app fails fast if it is missing
# or malformed rather than silently pointing at the wrong backend.

# ---- HireX API (NestJS) base URL, no trailing slash ----
NEXT_PUBLIC_API_URL=http://localhost:4000
