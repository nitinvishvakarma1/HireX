# HireX — environment template. Copy to .env and fill in real values.
# Committed to git. NEVER put real secrets here — placeholders only.

# ---- Supabase Postgres ----
# URL-encode special chars in the password (e.g. # -> %23, $ -> %24, @ -> %40).
DATABASE_URL=postgresql://postgres:your-db-password@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_HOST=db.<project-ref>.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-db-password

# ---- Supabase Storage (S3-compatible) ----
STORAGE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
STORAGE_S3_REGION=ap-south-1
STORAGE_S3_ACCESS_KEY_ID=your-access-key-id
STORAGE_S3_SECRET_ACCESS_KEY=your-secret-access-key
STORAGE_BUCKET=your-bucket-name

# ---- AI ----
ANTHROPIC_API_KEY=your-anthropic-api-key

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- API runtime ----
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# ---- Web (client) ----
# Base URL the Next.js app calls; must be exposed with the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_API_URL=http://localhost:3001
